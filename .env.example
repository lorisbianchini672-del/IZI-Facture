# ============================================================
# IZI — Modèle de configuration
# ------------------------------------------------------------
# Copier ce fichier puis renseigner les vraies valeurs :
#   cp .env.example .env && chmod 600 .env
# .env est ignoré par Git et chargé par lib/env.js (chemin absolu) :
# c'est la SEULE source des secrets, aucun n'est écrit dans le code.
# Ne jamais coller de secret réel dans ce modèle.
# ============================================================
PORT=4242
PUBLIC_URL=http://localhost:4242

# ---- Environnement ----
# production active les cookies Secure et le mode strict.
# NODE_ENV=production
# Rend bloquant tout manque de configuration critique (jeton admin, etc.).
# IZI_ENFORCE_ENV=1

# ---- Base de données : Supabase (obligatoire en production) ----
# URL du projet Supabase (ex: https://xxxx.supabase.co)
SUPABASE_URL=
# Clé de service (Settings → API → service_role). Ne JAMAIS exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (à configurer par l'administrateur) ----
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---- Sécurité ----
# À CHANGER obligatoirement avant la mise en production
ADMIN_TOKEN=change-this-token

# ---- Envoi d'emails (SMTP) ----
# SMTP_USER = compte qui s'authentifie auprès du serveur (ex. compte Gmail).
# MAIL_FROM = adresse affichée comme expéditeur. Avec Gmail, elle doit être
# soit identique à SMTP_USER, soit un alias vérifié de ce compte
# (Paramètres Gmail → Comptes → « Envoyer des emails en tant que »),
# sinon les envois sont refusés : 550 5.7.1 From address not authorized.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=replace_me
MAIL_FROM=notifications@example.com
# Contrôle de la configuration et de l'authentification : npm run check:smtp

# ---- Campagne de prospection (optionnel) ----
# Requis pour tout envoi réel (--test / --send) :
# PROSPECTION_SENDER_NAME=Votre Nom (ou société)
# PROSPECTION_PRIVACY_URL=https://votre-site.fr/confidentialite.html
# PROSPECTION_SITE_URL=https://votre-site.fr
# PROSPECTION_CONTACT=izifacturation@gmail.com
# PROSPECTION_REPLY_TO=contact@votre-domaine.fr
# EMAIL_FROM=contact@votre-domaine.fr
# Débit d'envoi (quotas quotidiens à vérifier auprès du fournisseur)
# CAMPAGNE_BATCH_SIZE=30
# CAMPAGNE_DELAY_MS=3000
# CAMPAGNE_PAUSE_MS=60000
