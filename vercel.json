{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "*.html",
          "*.json",
          "*.css",
          "*.svg",
          "*.png",
          "*.ico",
          "*.txt",
          "*.xml",
          "*.webmanifest",
          "fonts/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(data|lib|scripts|supabase|backup|node_modules)/(.*)",
      "status": 404
    },
    {
      "src": "/\\.(git|vercel|xgrok|github|env)(.*)",
      "status": 404
    },
    {
      "src": "/(.*)\\.(js|json|md|sql|sh|map|log|tmp)$",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
